Label {
    margin: 1;
}

StartPageTab Label {
    margin: 0;
}

/* стартовая вкладка: шапка, "Продолжить", слева работы, справа главы */
#start_head {
    height: 1;
    background: $panel;

    Label {
        padding: 0 1;
    }

    #greeting {
        width: 1fr;
        text-style: bold;
    }

    #loading {
        color: $text-muted;
    }

    ClickableLabel {
        width: auto;
        margin-left: 1;
        background: $panel-lighten-2;

        &:hover, &:focus {
            background: $accent;
            color: $background;
            text-style: none;
        }
    }
}

#recent {
    height: 1;
    margin: 1 1 0 1;
    display: none;

    .recent_head {
        color: $text-muted;
        padding-right: 1;
    }

    ClickableLabel {
        width: auto;
        padding: 0 1;
        margin-right: 1;
        background: $panel;
    }
}

#start_main {
    height: 1fr;
}

#start_left {
    width: 44;
    height: 1fr;
    /* поиск поверх низа списка: список не сдвигается */
    layers: base above;
}

#start_right {
    width: 1fr;
    padding: 0 1;
}

FicList, ChapterList {
    height: 1fr;
    border: round $panel-lighten-2;
    border-title-style: bold;
    border-subtitle-color: $text-muted;

    &:focus {
        border: round $accent;
    }

    & > .option-list--option {
        padding: 0 1;
    }
}

#fic_search {
    layer: above;
    dock: bottom;
    width: 100%;
    height: 3;
    margin: 0 1 1 1;
    padding: 0 1;
    border: round $accent;
    border-title-color: $accent;
    border-subtitle-color: $text-muted;
    background: $surface;
    display: none;

    &.-open {
        display: block;
    }
}

#fic_status {
    height: 1;
    margin: 1 0;

    #fic_title {
        padding: 0 1;
        text-style: bold;
    }

    #fic_meta {
        color: $text-muted;
    }
}

#fic_role {
    padding: 0 1;
    background: $panel-lighten-1;
    text-style: bold;
    color: $background;

    &.-author {
        background: $primary;
    }

    &.-coauthor {
        background: $secondary;
    }

    &.-beta {
        background: $success;
    }

    &.-gamma {
        background: $warning;
    }

    &.-gone {
        background: $error;
    }
}

/* footer и строка о главе справа в одну строку */
#bottom_bar {
    dock: bottom;
    height: 1;
    background: $footer-background;

    Footer {
        dock: none;
        width: 1fr;
    }
}

#chapter_info {
    width: auto;
    margin: 0 1;
    color: $footer-foreground;
}

/* теги, которые видит читатель */
ChapterEditor > .chapter-editor--b {
    color: $warning;
}

ChapterEditor > .chapter-editor--i {
    color: $success;
}

ChapterEditor > .chapter-editor--s {
    color: $error;
}

ChapterEditor > .chapter-editor--center, ChapterEditor > .chapter-editor--right {
    color: $primary;
}

ChapterEditor > .chapter-editor--footnote {
    color: $secondary;
}

ChapterEditor > .chapter-editor--tab {
    color: $accent;
}

/* тире фоном: цвета текста заняты тегами; среднее в прозе обычно ошибка */
ChapterEditor > .chapter-editor--emdash {
    background: $primary-muted;
}

ChapterEditor > .chapter-editor--endash {
    background: $error;
}

ChapterEditor > .chapter-editor--error {
    background: $error-muted;
}

/* редактор и панель читателя пополам, название и ошибка разметки - по краям */
ChapterTab {
    layout: horizontal;

    Input {
        dock: top;
    }

    ChapterEditor {
        width: 1fr;
    }
}

#markup_error {
    dock: bottom;
    height: auto;
    padding: 0 1;
    color: $text-error;
    background: $error-muted;
}

/* WYSIWYG на всю ширину вкладки, отступы - как у рамки редактора */
VisualEditor {
    width: 1fr;
    padding: 1 2;
    overflow-y: scroll;
    border: tall $border-blurred;

    &:focus {
        border: tall $border;
    }

    & > .visual-editor--hidden, & > .visual-editor--footnote {
        color: $text-muted;
    }

    & > .visual-editor--cursor {
        color: $background;
        background: $foreground;
    }

    & > .visual-editor--selection {
        background: $primary 40%;
    }

    /* тире - как в редакторе разметки */
    & > .visual-editor--emdash {
        background: $primary-muted;
    }

    & > .visual-editor--endash {
        background: $error;
    }
}

ReaderPanel {
    width: 1fr;
    /* сверху и снизу - как рамка редактора: строки вровень */
    padding: 1 1;
    overflow-y: scroll;
    border-left: vkey $foreground 20%;

    & > .reader-panel--footnote {
        color: $text-muted;
    }

    & > .reader-panel--current {
        background: $foreground 8%;
    }
}
