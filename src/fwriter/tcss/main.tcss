StartPageTab {
    align: center middle;
}

Rule {
    color: $surface;
}

Label {
    margin: 1;
}

#greeting {
    margin: 1 0 0 0;
}

.fics_container {
    content-align: center middle;
    padding: 0 12;
    overflow-y: auto;
    scrollbar-background: #0b0b0b;
}

.fics_collapsibles_label {
    margin: 1 1 1 1;
}

CollapsibleTitle, ClickableLabel {
    width: 1fr;
}

/* отступы - padding, а не margin, как у Label: по ним тоже можно кликнуть */
ClickableLabel {
    margin: 0;
    padding: 1 1 0 1;
}

.new_chapter_btn {
    padding: 1;
}

Collapsible {
    padding: 0;
    border-top: none;
}

CollapsibleTitle {
    padding: 0 1 1 2;
    border-top: hkey $background;
    
    &:focus {
        background: transparent;
        color: $foreground;
        text-style: underline;
    }
    &:hover {
        background: $block-hover-background;
    }
}

Collapsible > Contents {
    padding: 0 0 1 4;
}
