StartPageTab {
    align: center middle;
}

Rule {
    color: $surface;
}

Label {
    margin: 1;
}

#greeting {
    margin: 1 0 0 0;
}

#greeting_row {
    height: auto;

    .side {
        width: 1fr;
        margin: 1 0 0 1;
    }
}

.fics_container {
    content-align: center middle;
    padding: 0 12;
    overflow-y: auto;
    scrollbar-background: #0b0b0b;
}

.fics_collapsibles_label {
    margin: 1 1 1 1;
}

CollapsibleTitle, ClickableLabel {
    width: 1fr;
}

/* отступы - padding, а не margin, как у Label: по ним тоже можно кликнуть */
ClickableLabel {
    margin: 0;
    padding: 1 1 0 1;
}

.new_chapter_btn {
    padding: 1;
}

.chapter_row {
    height: auto;

    /* крестик сразу за названием, а не у правого края */
    .chapter_btn {
        width: auto;
    }
}

.trash_btn {
    width: auto;
    color: $text-muted;

    &.-armed {
        color: $error;
    }
}

Collapsible {
    padding: 0;
    border-top: none;
}

CollapsibleTitle {
    padding: 0 1 1 2;
    border-top: hkey $background;
    
    &:focus {
        background: transparent;
        color: $foreground;
        text-style: underline;
    }
    &:hover {
        background: $block-hover-background;
    }
}

Collapsible > Contents {
    padding: 0 0 1 4;
}

/* footer и строка о главе справа в одну строку */
#bottom_bar {
    dock: bottom;
    height: 1;
    background: $footer-background;

    Footer {
        dock: none;
        width: 1fr;
    }
}

#chapter_info {
    width: auto;
    margin: 0 1;
    color: $footer-foreground;
}

/* теги, которые видит читатель */
ChapterEditor > .chapter-editor--b {
    color: $warning;
}

ChapterEditor > .chapter-editor--i {
    color: $success;
}

ChapterEditor > .chapter-editor--s {
    color: $error;
}

ChapterEditor > .chapter-editor--center, ChapterEditor > .chapter-editor--right {
    color: $primary;
}

ChapterEditor > .chapter-editor--footnote {
    color: $secondary;
}

ChapterEditor > .chapter-editor--tab {
    color: $accent;
}

/* тире фоном: цвета текста заняты тегами; среднее в прозе обычно ошибка */
ChapterEditor > .chapter-editor--emdash {
    background: $primary-muted;
}

ChapterEditor > .chapter-editor--endash {
    background: $error;
}

ChapterEditor > .chapter-editor--error {
    background: $error-muted;
}

/* редактор и панель читателя пополам, название и ошибка разметки - по краям */
ChapterTab {
    layout: horizontal;

    Input {
        dock: top;
    }

    ChapterEditor {
        width: 1fr;
    }
}

#markup_error {
    dock: bottom;
    height: auto;
    padding: 0 1;
    color: $text-error;
    background: $error-muted;
}

ReaderPanel {
    width: 1fr;
    /* сверху и снизу - как рамка редактора: строки вровень */
    padding: 1 1;
    overflow-y: scroll;
    border-left: vkey $foreground 20%;

    & > .reader-panel--footnote {
        color: $text-muted;
    }

    & > .reader-panel--current {
        background: $foreground 8%;
    }
}
